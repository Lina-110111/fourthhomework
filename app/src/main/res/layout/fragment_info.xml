<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView android:id="@+id/tv_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:layout_marginBottom="10dp"/>
    <TextView android:id="@+id/tv_sid" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:layout_marginBottom="10dp"/>
    <TextView android:id="@+id/tv_high_score" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:textColor="#FF0000" android:layout_marginBottom="20dp"/>

    <Button android:id="@+id/btn_change" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="模拟修改姓名并保存"/>
</LinearLayout>